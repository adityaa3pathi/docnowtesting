generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// ENUMS
// ============================================

enum Role {
  USER
  MANAGER
  SUPER_ADMIN
  DOCTOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum RewardType {
  REFEREE_SIGNUP
  REFERRER_ORDER
}

enum RewardStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PaymentStatus {
  INITIATED       // Order created, awaiting payment
  AUTHORIZED      // Payment verified, partner booking pending
  PAID            // Zero-amount: fully covered by wallet/promo
  PROCESSING      // Claimed by finalization service/reconciler
  CONFIRMED       // Partner booking success & payment success
  PARTNER_FAILED  // Payment OK, partner API failed
  FAILED          // Payment failed or signature invalid
  CANCELLED       // User cancelled or system rollback
  EXPIRED         // Abandoned: no payment within TTL
  REFUNDED        // Max partner retries exhausted, money returned
}

enum ManagerOrderStatus {
  CREATED
  SENT
  PAYMENT_RECEIVED
  PAYMENT_CONFIRMED
  CONFIRMED
  CANCELLED
  BOOKING_FAILED
  REFUNDED
}

enum CollectionMode {
  RAZORPAY_LINK
  OFFLINE_CASH
  OFFLINE_UPI
}

enum CorporateInquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

// ============================================
// USER MODEL (Updated)
// ============================================

model User {
  id            String     @id @default(uuid())
  name          String?
  email         String?    @unique
  mobile        String     @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isVerified    Boolean    @default(false)
  // NMC telemedicine consent ticked at sign-up; covers the account holder's own consultations.
  telemedicineConsentAt      DateTime?
  telemedicineConsentVersion String?
  gender        String?
  age           Int?
  dob           DateTime?
  password      String?
  
  // New fields for Admin & Referral
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  referralCode  String?    @unique
  referredById  String?
  
  // Relations
  addresses     Address[]
  bookings      Booking[]
  patients      Patient[]
  cart          Cart?
  wallet        Wallet?
  referredBy    User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]     @relation("Referrals")
  referralRewardsEarned ReferralReward[] @relation("ReferrerRewards")
  auditLogs     AdminAuditLog[]
  promoRedemptions PromoRedemption[]
  managerOrders           ManagerOrder[] @relation("ManagerOrders")
  customerOrders          ManagerOrder[] @relation("CustomerOrders")
  managerCreatedBookings  Booking[]      @relation("ManagerCreatedBookings")

  // Session management
  tokenVersion  Int        @default(0)   // Increment to force-logout all sessions
  sessions      Session[]
  // Set when the person deleted their account in the app: contact details are wiped and the
  // account is blocked; clinical and financial records the law requires us to keep stay de-identified.
  deletedAt     DateTime?

  // AI Support Agent
  supportConversations SupportConversation[]

  // Doctor Consultation
  doctorProfile DoctorProfile?
  consultations Consultation[]
  familyLinkedPatients Patient[] @relation("FamilyLinkedPatients")
  consultationAttachments ConsultationAttachment[]
  patientDocuments PatientDocument[]
  vitalReadings    VitalReading[]
  doctorReviews    DoctorReview[]
  appReview        AppReview?
  periodLogs       PeriodLog[]

  // Mobile push notifications
  pushTokens    PushToken[]
  instantRequests InstantRequest[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String              // SHA-256 hash of the refresh token
  familyId         String              // Groups tokens in a rotation chain
  expiresAt        DateTime
  revokedAt        DateTime?           // Non-null = revoked
  replacedById     String?   @unique   // Points to next token in rotation chain
  createdAt        DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  clientType       String    @default("web") // "web" or "mobile"

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       Session?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replacesSession  Session?  @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model OTP {
  id         String   @id @default(uuid())
  identifier String   @unique
  code       String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Patient {
  id           String        @id @default(uuid())
  userId       String
  name         String
  relation     String
  age          Int
  gender       String
  dob          DateTime?

  // Assisted family consultations. `phone` is the family member's own 10-digit mobile; whoever
  // signs in with it sees consultations booked for this person, and gets clinical access only
  // after accepting once ("Aditya booked this for you, is this you?"), so a mistyped number
  // never exposes health details. Changing the phone clears the link.
  phone              String?
  preferredLanguage  String    @default("hi") // hi | en
  bloodGroup         String?
  allergies          String[]  @default([])
  // Set when the allergies were confirmed (a list, or "no known allergies"). Null with an empty
  // list means nobody has asked yet, which the doctor sees as "not confirmed".
  allergiesConfirmedAt DateTime?
  chronicConditions  String[]  @default([])
  currentMedications String[]  @default([])
  linkedUserId       String?
  linkedAt           DateTime?
  linkDeclinedAt     DateTime?

  bookingItems BookingItem[]
  cartItems    CartItem[]
  consultations Consultation[]
  documents    PatientDocument[]
  vitalReadings VitalReading[]
  periodLogs   PeriodLog[]
  instantRequests InstantRequest[]
  user         User          @relation(fields: [userId], references: [id])
  linkedUser   User?         @relation("FamilyLinkedPatients", fields: [linkedUserId], references: [id])

  @@index([phone])
  @@index([linkedUserId])
}

model Address {
  id        String    @id @default(uuid())
  userId    String
  line1     String
  city      String
  pincode   String
  lat       String?
  long      String?
  isDeleted Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  bookings  Booking[]
}

model Booking {
  id                String        @id @default(uuid())
  userId            String
  partnerBookingId  String?
  partnerStatus     String?           // Raw Healthians BS code (e.g. "BS008")
  status            String
  slotDate          String
  slotTime          String
  partnerSlotId     String?       // Actual Healthians slot stm_id
  totalAmount       Float
  paymentStatus     PaymentStatus @default(INITIATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  paidAt            DateTime?
  // ONLINE, or PAY_ON_COLLECTION: the Healthians collector takes finalAmount at the home visit.
  paymentMethod     String        @default("ONLINE")
  collectedAt       DateTime?     // pay on collection: when Healthians reported the money taken
  collectedAmount   Float?
  partnerError      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  addressId         String?
  billingName       String?           // Optional billing name for invoice
  billingGender     String?           // Gender of billing person (for Healthians)
  idempotencyKey    String?       @unique  // Prevent double-initiate
  address           Address?      @relation(fields: [addressId], references: [id])

  // Camp support
  campId            String?
  camp              Camp?         @relation(fields: [campId], references: [id])

  createdByManagerId   String?       // Reference to manager who created this
  managerOrder         ManagerOrder? // One-to-one relation
  creatorUser          User?         @relation("ManagerCreatedBookings", fields: [createdByManagerId], references: [id])

  // Leased atomic claim fields
  processingAttemptId  String?       // UUID lease token — set during PROCESSING claim
  processingStartedAt  DateTime?     // When PROCESSING was claimed — used for stale lease detection

  // Address snapshot — immutable copy of address at booking time
  addressLine       String?
  addressCity       String?
  addressPincode    String?
  addressLat        String?
  addressLong       String?

  user              User          @relation(fields: [userId], references: [id])
  items             BookingItem[]
  reports           Report[]
  rescheduledToId   String?       @unique
  partnerRetry      PartnerRetry?

  // Phlebo tracking (from Healthians webhook)
  phleboName        String?
  phleboPhone       String?           // Masked number
  phleboTrackingUrl String?

  // Price Breakdown
  discountAmount    Float         @default(0)
  walletAmount      Float         @default(0)
  finalAmount       Float         @default(0)
  
  promoCodeId       String?
  promoCode         PromoCode?    @relation(fields: [promoCodeId], references: [id])
  redemption        PromoRedemption?

  @@index([paymentStatus, updatedAt])     // Reconciler queries
  @@index([userId, paymentStatus])        // Active booking check
  @@index([partnerStatus])               // Webhook/reconciler/debug queries
}

model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  patientId String
  testCode  String
  testName  String
  price     Float
  status    String?
  booking   Booking @relation(fields: [bookingId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Report {
  id               String    @id @default(uuid())
  bookingId        String
  vendorCustomerId String    @default("")      // Healthians vendor_customer_id → maps to patient
  sourceUrl        String                      // Original signed URL (expires, for debug/retry)
  storageKey       String?                     // Canonical: "reports/{bookingId}/{id}.pdf"
  fetchStatus      String    @default("PENDING") // PENDING | STORED | FAILED
  fetchError       String?                     // Last error if download failed
  fetchedAt        DateTime?                   // When we successfully stored the file
  isFullReport     Boolean   @default(false)   // Healthians full_report flag
  verifiedAt       DateTime?                   // From Healthians verified_at
  fileSize         Int?                        // PDF file size in bytes
  generatedAt      DateTime  @default(now())
  booking          Booking   @relation(fields: [bookingId], references: [id])
  notifications    ReportNotification[]
  consultations    ConsultationReport[]

  @@unique([bookingId, vendorCustomerId, isFullReport, verifiedAt])
}

// One row per report per channel, claimed before sending, so "report ready" never goes out twice.
model ReportNotification {
  id         String   @id @default(uuid())
  reportId   String
  channel    String // push
  status     String   @default("SENDING") // SENDING | SENT | FAILED
  attempts   Int      @default(1)
  lastError  String?
  providerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, channel])
}

model CallbackRequest {
  id        String   @id @default(uuid())
  name      String
  mobile    String
  city      String
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorporateInquiry {
  id              String                 @id @default(uuid())
  contactName     String
  workEmail       String
  mobile          String
  companyName     String
  city            String
  companySize     String
  requirementType String
  summary         String?
  status          CorporateInquiryStatus @default(NEW)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([city])
  @@index([requirementType])
  @@index([companyName])
}

model Cart {
  id             String     @id @default(uuid())
  userId         String     @unique
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([lastActivityAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  testCode  String
  testName  String
  price     Float
  mrp       Float?
  patientId String?
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  patient   Patient? @relation(fields: [patientId], references: [id])
}

// ============================================
// WALLET SYSTEM
// ============================================

model Wallet {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  ledger    WalletLedger[]
  balance   Float          @default(0) // Cached balance for atomic updates
}

model WalletLedger {
  id            String     @id @default(uuid())
  walletId      String
  type          LedgerType
  amount        Float      // Actual signed amount (+/-)
  balanceAfter  Float      // Running balance after this transaction
  description   String
  referenceType String?    // REFERRAL | TOPUP | REFUND | ORDER | ADMIN
  referenceId   String?    // ID of related entity
  createdAt     DateTime   @default(now())
  createdById   String?    // Admin userId for adjustments
  ipAddress     String?
  
  wallet        Wallet     @relation(fields: [walletId], references: [id])
  
  @@index([walletId, createdAt])
  @@unique([referenceType, referenceId]) // Prevent double-refund at DB level
}

// ============================================
// REFERRAL SYSTEM
// ============================================

model ReferralReward {
  id              String       @id @default(uuid())
  referrerId      String
  refereeId       String
  rewardType      RewardType
  amount          Float
  status          RewardStatus @default(PENDING)
  triggerEvent    String       // SIGNUP | FIRST_ORDER_COMPLETE
  triggerEntityId String?      // bookingId for order completion
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  
  referrer        User         @relation("ReferrerRewards", fields: [referrerId], references: [id])
  
  @@unique([referrerId, refereeId, rewardType])
  @@index([refereeId, rewardType])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?  // Admin userId who last updated
}

// ============================================
// ADMIN AUDIT LOG
// ============================================

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String
  adminName     String
  action        String   // WALLET_CREDIT | WALLET_DEBIT | CONFIG_UPDATE | USER_BLOCK etc.
  entity        String   // User | Wallet | Config | Order
  targetId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  isDestructive Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  admin         User     @relation(fields: [adminId], references: [id])
  
  @@index([adminId, createdAt])
  @@index([entity, targetId])
}

// ============================================
// PAYMENT WEBHOOK DEDUPLICATION
// ============================================

model WebhookEvent {
  eventId   String   @id  // Razorpay event ID - unique by design
  processed Boolean  @default(true)
  createdAt DateTime @default(now())
  
  @@index([createdAt])
}

// ============================================
// MULTI-SOURCE WEBHOOK DEDUPLICATION (v2)
// ============================================

model WebhookEventV2 {
  id           String   @id @default(uuid())
  payloadHash  String   @unique              // SHA-256 of raw body
  source       String                        // "razorpay" | "healthians"
  eventType    String?                       // e.g. "status_updated", "report_uploaded"
  bookingId    String?                       // Partner booking ID for cross-ref
  rawPayload   Json?                         // Full payload for replay/debugging
  processed    Boolean  @default(false)      // false until business logic completes
  createdAt    DateTime @default(now())

  @@index([source, createdAt])
  @@index([bookingId])
  @@index([processed, createdAt])            // Dead-letter detection
}

// ============================================
// PROMO CODE SYSTEM
// ============================================

model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique // Case-insensitive storage (uppercase)
  description     String?
  discountType    DiscountType
  discountValue   Float
  maxDiscount     Float?   // Cap for percentage discount
  minOrderValue   Float    @default(0)
  
  maxRedemptions  Int?     // Global limit (null = unlimited)
  maxPerUser      Int      @default(1) // Per-user limit (how many times each user can redeem)
  redeemedCount   Int      @default(0) // Atomic counter
  
  startsAt        DateTime @default(now())
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  
  // Where the code can be used. Codes made before consultations had promos are LAB.
  appliesTo       PromoAppliesTo @default(LAB)
  // Consultations only: limited to these doctors / specialties (none = any doctor).
  scopes          PromoCodeScope[]

  redemptions     PromoRedemption[]
  bookings        Booking[]
  consultations   Consultation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PromoAppliesTo {
  LAB
  CONSULT
  BOTH
}

// One row per doctor or specialty a consultation promo is limited to (exactly one of the two is set,
// a raw-SQL CHECK). A consultation matches when its doctor or the doctor's specialty is listed.
// The consult-home concern tiles each map to a specialty, so a specialty also covers a "symptom".
model PromoCodeScope {
  id          String         @id @default(uuid())
  promoCodeId String
  doctorId    String?
  specialtyId String?
  createdAt   DateTime       @default(now())

  promoCode PromoCode      @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, doctorId])
  @@unique([promoCodeId, specialtyId])
  @@index([doctorId])
  @@index([specialtyId])
}

model PromoRedemption {
  id          String    @id @default(uuid())
  userId      String
  promoCodeId String
  bookingId   String?   @unique // Optional if redemption happens before booking creation, but usually locked to booking
  consultationId String? @unique // a consultation's use of the code (a redemption has a booking or a consultation)
  redeemedAt  DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  
  @@index([userId, promoCodeId])
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ============================================
// PARTNER RETRY QUEUE (Dead-letter pattern)
// ============================================

model PartnerRetry {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  nextRetryAt DateTime @default(now())
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([nextRetryAt, attempts])
}

// ============================================
// INTERNAL CATALOG (Manager-controlled)
// ============================================

enum CatalogItemType {
  TEST
  PACKAGE
  PROFILE
}

model CatalogItem {
  id               String             @id @default(uuid())
  partnerCode      String             @unique   // Healthians deal_id — canonical key
  name             String
  searchName       String             @default("")  // Lowercase, stripped of hyphens/spaces/special chars for fuzzy search
  type             CatalogItemType    @default(TEST)
  
  // Pricing: manager-set
  partnerPrice     Float              // Healthians base price (reference only)
  displayPrice     Float              // Manager price shown to users
  discountedPrice  Float?             // Optional sale price
  
  // Metadata
  description      String?
  parameters       String?            // e.g. "Includes 60+ parameters"
  sampleType       String?            // e.g. "Blood"
  reportTime       String?            // e.g. "24-48 hours"
  purpose          String?            // Manager-written "What it's for"; catalog sync never writes it
  fastingOverride     String?         // Manager correction of Healthians' fasting: "Required" | "Not Required"; catalog sync never writes it
  fastingTimeOverride String?         // With fastingOverride "Required", e.g. "12 hour(s)"; null otherwise
  searchPurpose    String             @default("")  // Lowercase, stripped of hyphens/spaces/special chars for fuzzy search
  partnerData      Json?              // Raw Healthians response for reference
  detailsData      Json?              // Cached normalized Healthians detail metadata for cards/detail pages
  detailsFetchedAt DateTime?
  detailsFetchStatus String?
  detailsFetchError  String?
  
  isEnabled        Boolean            @default(true)
  
  // Landing page featured controls
  isFeatured       Boolean            @default(false)
  featuredOrder    Int?               // Lower = appears first on landing page
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  categories       CatalogItemCategory[]
  campItems        CampCatalogItem[]
  
  @@index([isEnabled])
  @@index([type, isEnabled])
  @@index([isFeatured, type, featuredOrder])
  @@index([searchName])
  @@index([searchPurpose])
}

model Category {
  id          String              @id @default(uuid())
  name        String              @unique
  slug        String              @unique
  description String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  items       CatalogItemCategory[]
  
  @@index([isActive, sortOrder])
}

model CatalogItemCategory {
  id            String      @id @default(uuid())
  catalogItemId String
  categoryId    String
  sortOrder     Int         @default(0)
  
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([catalogItemId, categoryId])
  @@index([categoryId, sortOrder])
}
model ManagerOrder {
  id              String             @id @default(uuid())
  bookingId       String             @unique
  managerId       String
  customerId      String
  status          ManagerOrderStatus @default(CREATED)
  collectionMode  CollectionMode?
  totalAmount     Float
  razorpayLinkId  String?
  razorpayLinkUrl String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  booking         Booking            @relation(fields: [bookingId], references: [id])
  manager         User               @relation("ManagerOrders", fields: [managerId], references: [id])
  customer        User               @relation("CustomerOrders", fields: [customerId], references: [id])

  @@index([managerId, status])
  @@index([customerId])
}

// ============================================
// HEALTH CAMPS
// ============================================

model Camp {
  id          String            @id @default(uuid())
  name        String
  description String?
  location    String            // Physical venue address
  city        String
  pincode     String
  startDate   DateTime
  endDate     DateTime
  price       Float             // Single patient price
  familyPrice Float             // Family/group price (2+ patients)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items       CampCatalogItem[]
  bookings    Booking[]

  @@index([isActive, startDate])
  @@index([city])
}

model CampCatalogItem {
  id            String      @id @default(uuid())
  campId        String
  catalogItemId String
  camp          Camp        @relation(fields: [campId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([campId, catalogItemId])
  @@index([campId])
  @@index([catalogItemId])
}

// ============================================
// HERO CAROUSEL CMS
// ============================================

model HeroSlide {
  id               String   @id @default(uuid())
  title            String   @default("")
  subtitle         String   @default("")
  badgeText        String?
  ctaText          String   @default("Book a Test")
  ctaLink          String   @default("/search")
  secondaryCtaText String?
  secondaryCtaLink String?
  imageUrl         String?
  desktopImageUrl  String?
  desktopImageKey  String?
  mobileImageUrl   String?
  mobileImageKey   String?
  imageAlt         String?
  bgGradient       String   @default("radial-gradient(594.6% 81.5% at 50% 63.68%, #4B0082 25.49%, #2A004A 74.17%)")
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ============================================
// AI SUPPORT AGENT
// ============================================

model KnowledgeChunk {
  id         String                          @id @default(uuid())
  source     String                          // "catalog" | "faq" | "policy" | "booking_help"
  sourceId   String?                         // CatalogItem.id for catalog chunks; null for static docs
  title      String
  content    String                          // The actual text chunk (200-500 tokens)
  embedding  Unsupported("vector(768)")?     // Gemini text-embedding-004 = 768 dims
  metadata   Json?                           // Structured data: { price, type, partnerCode, ... }
  version    Int              @default(1)    // For re-embedding tracking
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([source])
  @@index([sourceId])
}

model SupportConversation {
  id        String   @id @default(uuid())
  userId    String
  status    String   @default("ACTIVE")      // ACTIVE | RESOLVED | ESCALATED
  summary   String?                          // Auto-generated topic summary
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  SupportMessage[]
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
}

model SupportMessage {
  id              String   @id @default(uuid())
  conversationId  String
  role            String                     // "user" | "assistant" | "system"
  content         String
  sources         Json?                      // Retrieved chunks used
  actionsTaken    Json?                      // Actions executed
  verifierVerdict String?                    // GROUNDED | PARTIALLY_GROUNDED | UNGROUNDED
  wasAbstained    Boolean  @default(false)
  tokenCount      Int?
  latencyMs       Int?
  langfuseTraceId String?
  feedbackScore   Int?                       // 1 = thumbs down, 5 = thumbs up
  createdAt       DateTime @default(now())

  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}


// ============================================
// DOCTOR CONSULTATION
// ============================================

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

model Specialty {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  doctors     DoctorProfile[]
  promoScopes PromoCodeScope[]
}

model DoctorProfile {
  id                  String       @id @default(uuid())
  userId              String       @unique
  specialtyId         String
  displayName         String
  // Stable DocNow link that redirects to a fresh private-storage link; photoKey is the stored file.
  photoUrl            String?
  photoKey            String?
  gender              String? // Male | Female | Other, given at onboarding; older profiles fill it in later
  qualification       String
  registrationNumber  String
  registrationCouncil String
  experienceYears     Int          @default(0)
  languages           String[]
  bio                 String?
  consultationFee     Float
  slotMinutes         Int          @default(15)
  status              DoctorStatus @default(PENDING)
  statusReason        String?
  createdByAdminId    String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  specialty    Specialty            @relation(fields: [specialtyId], references: [id])
  availability DoctorAvailability[]
  leaves       DoctorLeave[]
  slots        Slot[]
  consultations Consultation[]
  changeRequests DoctorChangeRequest[]
  movesFrom      ConsultationMove[] @relation("ConsultationMoveFrom")
  movesTo        ConsultationMove[] @relation("ConsultationMoveTo")
  promoScopes    PromoCodeScope[]
  presences      DoctorPresence[]
  instantRequests InstantRequest[]
  reviews        DoctorReview[]

  @@unique([registrationNumber, registrationCouncil])
  @@index([status, specialtyId])
}

// A doctor's own change to weekly hours (with slot length) or profile text waits here for a super
// admin; the live schedule and profile keep running until it is approved. At most one PENDING row per
// (doctor, kind): a raw-SQL partial unique index in the migration, which Prisma cannot express.
enum DoctorChangeKind {
  AVAILABILITY
  PROFILE
}

enum DoctorChangeStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED // the doctor sent a newer version before review
  WITHDRAWN // the doctor took it back
}

model DoctorChangeRequest {
  id           String             @id @default(uuid())
  doctorId     String
  kind         DoctorChangeKind
  // AVAILABILITY: { windows: [{ dayOfWeek, startMinute, endMinute }], slotMinutes }
  // PROFILE: only the changed fields of { bio, languages, experienceYears }
  payload      Json
  // The live values when the doctor sent it, so history shows what changed.
  previous     Json
  status       DoctorChangeStatus @default(PENDING)
  reviewReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  doctor       DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([doctorId, createdAt])
}

model DoctorAvailability {
  id          String        @id @default(uuid())
  doctorId    String
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday, in IST
  startMinute Int // minutes after midnight IST
  endMinute   Int
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime      @default(now())
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
}

model Slot {
  id       String        @id @default(uuid())
  doctorId String
  startsAt DateTime
  endsAt   DateTime
  status   SlotStatus    @default(AVAILABLE)
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultations Consultation[]
  instantRequest InstantRequest?

  @@unique([doctorId, startsAt])
  @@index([doctorId, status, startsAt])
}


// ============================================
// DOCTOR CONSULTATION: PAYMENTS
// ============================================
// Two indexes below are raw SQL in the migration because Prisma cannot express partial unique
// indexes: Consultation(slotId) for active statuses, and ConsultPolicy(isActive) where active.
// A refund amount check (amountPaise > 0) lives there too. Do not drop them in a generated migration.

enum ConsultationStatus {
  PENDING_PAYMENT
  CONFIRMED
  RESCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW_PATIENT
  NO_SHOW_DOCTOR
  EXPIRED
  REFUNDED
}

enum ConsultationType {
  VIDEO
  AUDIO
  CHAT
}

enum ConsultPaymentStatus {
  CREATED
  CAPTURED
  FAILED
  RELEASED // wallet part of a hold that ended unpaid: the money went back to the wallet
}

// Where a consultation payment came from. A booking has at most one of each: the card/UPI part
// through Razorpay and the part taken from the DocNow wallet.
enum ConsultPaymentSource {
  RAZORPAY
  WALLET
}

enum ConsultRefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ConsultRefundReason {
  PATIENT_CANCEL
  DOCTOR_NO_SHOW
  LATE_PAYMENT_SLOT_LOST
  PAID_AFTER_CANCEL
  DUPLICATE_PAYMENT
  ADMIN
  EXTERNAL
}

model ConsultPolicy {
  id          String   @id @default(uuid())
  version     Int      @unique
  isActive    Boolean  @default(false)
  rules       Json
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

model Consultation {
  id                  String             @id @default(uuid())
  userId              String
  patientId           String
  doctorId            String
  slotId              String
  type                ConsultationType   @default(VIDEO)
  status              ConsultationStatus @default(PENDING_PAYMENT)
  feePaise            Int
  platformFeePaise    Int
  policyId            String
  policySnapshot      Json
  holdExpiresAt       DateTime
  startsAt            DateTime
  idempotencyKey      String
  requestHash         String
  orderReceipt        String             @unique
  confirmingPaymentId String?
  reviewReason        String?
  cancelledBy         String?
  cancelReason        String?
  cancelledAt         DateTime?
  // Video call: 100ms room made on first join; times record who joined and when.
  roomId              String?            @unique
  patientJoinedAt     DateTime?
  doctorJoinedAt      DateTime?
  // Family bookings: the zero-login web link (docnow.in/call/<guestToken>), whether the booker said
  // they would co-join to assist, when they did, and when the family member themselves joined.
  guestToken          String?            @unique
  isCaregiverJoined   Boolean            @default(false)
  caregiverJoinedAt   DateTime?
  familyJoinedAt      DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  // Self-serve reschedules so far (the policy caps them; late-doctor moves don't count).
  rescheduleCount     Int                @default(0)
  // Paid from the DocNow wallet (taken when the slot is held). The card/UPI part is feePaise
  // minus this; a booking the wallet covers in full confirms without Razorpay.
  walletPaise         Int                @default(0)
  // Promo code used, and its discount. feePaise stays the full fee: DocNow bears the discount and
  // the doctor's share is worked out on the full fee (Aditya, 2026-11-23). Card part: fee - discount - wallet.
  promoCodeId         String?
  discountPaise       Int                @default(0)
  // The earliest start this booking had before the patient moved it. Cancellation refund tiers use
  // it, so moving a booking can never raise its refund. Null: never moved by the patient.
  refundBasisStartsAt DateTime?
  // Set while the patient lets this booking's doctor see their whole DocNow health record (until
  // 7 days after the visit). Null: the doctor sees only what was attached. History: RecordShareConsent.
  recordSharedAt      DateTime?
  // "Consult a Doc now" (P10): booked from an instant request a doctor accepted, starting at once.
  // Its policySnapshot carries the instant rules (full refund until the doctor joins, shorter doctor wait).
  isInstant           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user         User                  @relation(fields: [userId], references: [id])
  patient      Patient               @relation(fields: [patientId], references: [id])
  doctor       DoctorProfile         @relation(fields: [doctorId], references: [id])
  slot         Slot                  @relation(fields: [slotId], references: [id])
  payments     ConsultationPayment[]
  refunds      ConsultationRefund[]
  note          ConsultationNote?
  prescriptions Prescription[]
  notifications ConsultationNotification[]
  attachedReports ConsultationReport[]
  attachments     ConsultationAttachment[]
  consents        ConsultationConsent[]
  moves           ConsultationMove[]
  messages        ConsultationMessage[]
  recordShareConsents RecordShareConsent[]
  instantRequest  InstantRequest?
  review          DoctorReview?
  promoCode       PromoCode?           @relation(fields: [promoCodeId], references: [id])
  promoRedemption PromoRedemption?

  @@unique([userId, idempotencyKey])
  @@index([slotId])
  @@index([status, holdExpiresAt])
  @@index([userId, createdAt])
  @@index([doctorId, startsAt])
}

enum ConsultationMoveKind {
  PATIENT_RESCHEDULE // the patient picked another time with the same doctor, inside the policy
  DOCTOR_LATE_RESCHEDULE // the doctor was late; the patient moved to another time, same doctor
  DOCTOR_LATE_REASSIGN // the doctor was late; the patient moved to the next free doctor
}

// One row per move of a paid consultation to another slot. The consultation itself only keeps the
// current time, so this is what the no-show report and staff use to see where it was before.
model ConsultationMove {
  id                  String               @id @default(uuid())
  consultationId      String
  kind                ConsultationMoveKind
  fromDoctorId        String
  fromSlotId          String
  fromStartsAt        DateTime
  // Whether the patient was waiting in the room when it moved (the move clears the join time).
  fromPatientJoinedAt DateTime?
  toDoctorId          String
  toSlotId            String
  toStartsAt          DateTime
  byUserId            String?
  createdAt           DateTime             @default(now())

  consultation Consultation  @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  fromDoctor   DoctorProfile @relation("ConsultationMoveFrom", fields: [fromDoctorId], references: [id])
  toDoctor     DoctorProfile @relation("ConsultationMoveTo", fields: [toDoctorId], references: [id])

  @@index([consultationId, createdAt])
  @@index([kind, fromStartsAt])
}

enum ConsultationChatRole {
  DOCTOR
  PATIENT
  CARETAKER
}

// In-call text chat (P9). Names are not stored: they are read from the consultation, so account
// deletion de-identifies the chat with the rest of the record. Ordered by seq, a database sequence.
model ConsultationMessage {
  id             String                 @id @default(uuid())
  seq            Int                    @unique @default(autoincrement())
  consultationId String
  senderRole     ConsultationChatRole
  // The call identity that sent it: doctor:<doctorId>, patient:<patientId> or caretaker:<userId>.
  senderIdentity String
  body           String                 @db.VarChar(1000)
  // The sender's own id for this message, so a resend after a dropped reply is stored once.
  clientId       String
  createdAt      DateTime               @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@unique([consultationId, senderIdentity, clientId])
  @@index([consultationId, seq])
}

model ConsultationPayment {
  id                String               @id @default(uuid())
  consultationId    String
  source            ConsultPaymentSource @default(RAZORPAY)
  // Null only for the wallet part (one per consultation, a raw-SQL partial unique index).
  razorpayOrderId   String?
  razorpayPaymentId String?              @unique
  amountPaise       Int
  status            ConsultPaymentStatus @default(CREATED)
  capturedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  consultation Consultation         @relation(fields: [consultationId], references: [id])
  refunds      ConsultationRefund[]

  @@index([razorpayOrderId])
  @@index([consultationId])
}

model ConsultationRefund {
  id               String              @id @default(uuid())
  consultationId   String
  paymentId        String
  reason           ConsultRefundReason
  amountPaise      Int
  status           ConsultRefundStatus @default(PENDING)
  razorpayRefundId String?             @unique
  receipt          String              @unique
  attempts         Int                 @default(0)
  lastError        String?
  failureConfirmed Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  consultation Consultation        @relation(fields: [consultationId], references: [id])
  payment      ConsultationPayment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, reason])
  @@index([status, updatedAt])
}


// ============================================
// DOCTOR CONSULTATION: NOTES AND PRESCRIPTIONS
// ============================================

// The doctor's working notes; editable until the prescription is issued.
model ConsultationNote {
  id             String       @id @default(uuid())
  consultationId String       @unique
  complaints     String?
  findings       String?
  diagnosis      String?
  advice         String?
  followUpDays   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

// A legal record: content is written once. A correction voids it and adds the next version;
// raw SQL in the migration allows only one unvoided version per consultation.
model Prescription {
  id               String       @id @default(uuid())
  consultationId   String
  version          Int          @default(1)
  voidedAt         DateTime?
  voidReason       String?
  medicines        Json // [{ name, dose, frequency, duration, instructions }]
  recommendedTests Json // [{ code, name }] from the catalog at issue time
  advice           String?
  doctorSnapshot   Json // name, qualification, registration number and council at issue time
  patientSnapshot  Json // name, age, gender at issue time
  issuedAt         DateTime     @default(now())
  consultation     Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@unique([consultationId, version])
}

// One row per message per person per channel, claimed before sending, so a message never goes out twice.
model ConsultationNotification {
  id             String       @id @default(uuid())
  consultationId String
  kind           String // CONFIRMED | REMINDER | JOIN_NOW | PARTNER_WAITING | DOCTOR_NO_SHOW | PATIENT_NO_SHOW | PRESCRIPTION_ISSUED
  recipient      String // patient | doctor
  channel        String       @default("whatsapp") // whatsapp | push
  status         String       @default("SENDING") // SENDING | SENT | FAILED
  attempts       Int          @default(1)
  lastError      String?
  providerId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, kind, recipient, channel])
  @@index([status, updatedAt])
}

// ============================================
// MOBILE PUSH NOTIFICATIONS
// ============================================

// One row per phone. The token is unique, so a phone that signs in to another account moves to it.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Expo push token, e.g. ExponentPushToken[xxxx]
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // last time the app confirmed this token
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// A DocNow lab report the booker shared with the doctor for this consultation.
model ConsultationReport {
  consultationId String
  reportId       String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  report         Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([consultationId, reportId])
}

// A photo or PDF of an outside record (old prescription, discharge summary, lab report) the booker
// uploaded for the doctor. Stored privately; read through short-lived signed links only. Uploaded
// before booking, so consultationId stays empty until the booking claims it.
model ConsultationAttachment {
  id             String        @id @default(uuid())
  userId         String
  consultationId String?
  storageKey     String        @unique
  name           String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([userId, consultationId])
}


// A photo or PDF the patient keeps in their DocNow health record (Profile → Medical records), per
// person (self or a family member). Not tied to a booking. The doctor of a booking the patient
// shared their record with can open it until 7 days after the visit; every open is logged.
model PatientDocument {
  id         String   @id @default(uuid())
  userId     String // the account that uploaded it and owns the person
  patientId  String
  storageKey String   @unique
  name       String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([userId])
}

// Every switch of "let the doctor see my health record" on a booking, newest last. Append-only:
// Consultation.recordSharedAt is the current state, this is the proof of what was agreed and when.
model RecordShareConsent {
  id             String       @id @default(uuid())
  consultationId String
  userId         String? // who switched it (booker or accepted family member)
  granted        Boolean
  version        String // which wording was shown
  channel        String // web | app
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
}

// One row per time a doctor opened a patient's shared health record or a file in it. Plain ids (no
// relations), so the trail outlives a deleted file or family profile.
model HealthRecordAccess {
  id             String   @id @default(uuid())
  consultationId String
  doctorId       String
  patientId      String
  action         String // RECORD | DOCUMENT | REPORT | ATTACHMENT
  targetId       String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([consultationId, createdAt])
}

// P8 vitals tracker: readings and period logs a patient keeps per person (self or family). Only the
// owning account manages them. A doctor sees them only through P7 sharing (opt-in per booking, until
// 7 days after the visit, every view logged in HealthRecordAccess). Values are checked against what
// is physically possible, never against a "normal" range: DocNow shows no medical advice here.
model VitalReading {
  id          String   @id @default(uuid())
  userId      String // the account that logged it and owns the person
  patientId   String
  kind        String // BP | SUGAR
  systolic    Int? // mmHg, BP only
  diastolic   Int? // mmHg, BP only
  pulse       Int? // beats per minute, optional with BP
  glucoseMgDl Int? // mg/dL, SUGAR only
  sugarTiming String? // FASTING | BEFORE_MEAL | AFTER_MEAL | RANDOM, SUGAR only
  measuredAt  DateTime
  source      String   @default("MANUAL") // MANUAL: typed in by the patient
  note        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, kind, measuredAt])
  @@index([userId])
}

model PeriodLog {
  id        String    @id @default(uuid())
  userId    String
  patientId String
  startDate DateTime  @db.Date // IST calendar day
  endDate   DateTime? @db.Date // null while the period is still going
  flow      String? // LIGHT | MEDIUM | HEAVY
  symptoms  String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, startDate])
  @@index([userId])
}

// Telemedicine consent (NMC Telemedicine Practice Guidelines, 2020): recorded once per person on
// the patient's side, before the server lets them into the call. `userId` is deliberately not a
// relation, so the record survives an account deletion.
model ConsultationConsent {
  id             String       @id @default(uuid())
  consultationId String
  identity       String // the call identity that consented: patient:<patientId> or caretaker:<userId>
  userId         String? // the signed-in account, or empty for the zero-login family link
  channel        String // app | web | guest-link
  version        String // which consent wording was shown
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, identity])
}


// ============================================
// DOCTOR CONSULTATION: INSTANT ("Consult a Doc now", P10)
// ============================================
// Partial unique indexes are raw SQL in the migration (Prisma cannot express them): one open
// presence per doctor, one live request per user, and one ringing or accepted request per doctor.

// One period a doctor was online for instant consults. The open row (endedAt null) is the current
// one; it ends when the doctor switches off, stops checking in, or misses rings. P13 payroll reads these.
model DoctorPresence {
  id          String        @id @default(uuid())
  doctorId    String
  startedAt   DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  endedAt     DateTime?
  endReason   String? // OFF | TIMEOUT | MISSED_RINGS | NOT_APPROVED
  // Rings in a row left unanswered in this period; reset by an accept or a decline.
  missedRings Int           @default(0)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startedAt])
  @@index([endedAt, lastSeenAt])
}

enum InstantRequestStatus {
  SEARCHING // waiting for a free doctor
  RINGING // one doctor is being asked (doctorId, ringExpiresAt)
  ACCEPTED // that doctor said yes; the patient pays by payBy (nothing charged before this)
  BOOKED // paid: the consultation is the record from here
  CANCELLED // the patient stopped it
  NO_MATCH // nobody accepted before searchEndsAt
  UNPAID // a doctor accepted but the patient did not pay in time
}

// A patient asking for a doctor now. Nothing is charged until a doctor accepts; the accept creates
// a blocked slot at "now", and paying for it makes an ordinary consultation (isInstant).
model InstantRequest {
  id             String               @id @default(uuid())
  userId         String
  patientId      String
  reason         String
  shareRecord    Boolean              @default(false)
  status         InstantRequestStatus @default(SEARCHING)
  searchEndsAt   DateTime
  doctorId       String?
  ringExpiresAt  DateTime?
  rings          Int                  @default(0)
  // Doctors already asked (declined or timed out); not asked again for this request.
  triedDoctorIds String[]             @default([])
  // The doctor's free slots taken off sale under the paid instant call; reopened if it is cancelled.
  blockedSlotIds String[]             @default([])
  acceptedAt     DateTime?
  payBy          DateTime?
  slotId         String?              @unique
  consultationId String?              @unique
  endedAt        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  // A request that never became a consultation goes with the person it was for.
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile? @relation(fields: [doctorId], references: [id])
  slot         Slot?          @relation(fields: [slotId], references: [id])
  consultation Consultation?  @relation(fields: [consultationId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// REVIEWS (P11)
// ============================================

enum ReviewStatus {
  VISIBLE
  HIDDEN // a super admin took it off public pages; unhiding brings it back
  DELETED // soft delete: kept for the record, never shown again, not even to its author for editing
}

// A patient's review of one completed consultation: the booker or an accepted family member, within
// 48 h of the end. One per consultation, never edited afterwards (by the patient or the doctor). Only
// VISIBLE reviews are shown and counted; the average shows once there are 3. A super admin may hide,
// delete, reply, or redact personal data (text overwritten, redactedAt shown as "edited by DocNow").
// DocNow never writes reviews itself (Aditya, 2026-11-24: fake-review rules).
model DoctorReview {
  id             String       @id @default(uuid())
  consultationId String       @unique
  doctorId       String
  authorUserId   String
  rating         Int // 1 to 5, CHECK in the migration
  text           String?
  status         ReviewStatus @default(VISIBLE)
  redactedAt     DateTime?
  replyText      String?
  repliedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  consultation Consultation  @relation(fields: [consultationId], references: [id])
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id])
  author       User          @relation(fields: [authorUserId], references: [id])

  @@index([doctorId, status, createdAt])
  @@index([status, createdAt])
}

// One review of DocNow itself per account, which its author may change (unless DocNow deleted it).
// Moderated like doctor reviews.
model AppReview {
  id         String       @id @default(uuid())
  userId     String       @unique
  rating     Int // 1 to 5, CHECK in the migration
  text       String?
  status     ReviewStatus @default(VISIBLE)
  redactedAt DateTime?
  replyText  String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}
