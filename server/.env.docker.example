# Local Docker defaults only. Do not put production secrets here.
PORT=5000
NODE_ENV=development

JWT_SECRET=local-docker-jwt-secret-change-me
DATABASE_URL=postgresql://docnow:docnow@postgres:5432/docnow?schema=public

UPSTASH_REDIS_REST_URL=http://redis-http:80
UPSTASH_REDIS_REST_TOKEN=local-dev-token

GOOGLE_MAPS_API_KEY=local-dummy-google-key

HEALTHIANS_CLIENT_ID=local-dummy-healthians-client-id
HEALTHIANS_CLIENT_SECRET=local-dummy-healthians-client-secret
HEALTHIANS_BASE_URL=https://t25crm.healthians.co.in/api
HEALTHIANS_PARTNER_NAME=docnow-local
HEALTHIANS_BOOKING_SECRET_KEY=local-dummy-healthians-booking-secret
HEALTHIANS_WEBHOOK_SECRET=local-dummy-healthians-webhook-secret

RAZORPAY_KEY_ID=rzp_test_localdummy
RAZORPAY_KEY_SECRET=local-dummy-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=local-dummy-razorpay-webhook-secret

WAPPIE_API_URL=https://api.wappie.in/v2/whatsapp/messages/sendDirectly
WAPPIE_API_KEY=local-dummy-wappie-key
WAPPIE_WHATSAPP_FROM=+910000000000
WAPPIE_OTP_TEMPLATE_NAME=otp_authentication
WAPPIE_OTP_TEMPLATE_LANGUAGE=en
WAPPIE_REPORT_TEMPLATE_NAME=template_marketing_local
WAPPIE_REPORT_TEMPLATE_LANGUAGE=en
WAPPIE_INVOICE_TEMPLATE_NAME=invoice_ready
WAPPIE_INVOICE_TEMPLATE_LANGUAGE=en

APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INVOICE_LINK_EXPIRY_HOURS=72
REPORT_LINK_EXPIRY_HOURS=72
CACHE_OPERATION_TIMEOUT_MS=750

AWS_S3_BUCKET=local-dummy-report-bucket
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local-dummy-access-key
AWS_SECRET_ACCESS_KEY=local-dummy-secret-key
REPORT_STORAGE_PREFIX=reports-local

DOCNOW_COMPANY_NAME=DOCNOW
DOCNOW_REGISTERED_ADDRESS=Local Docker Development
DOCNOW_SUPPORT_PHONE=+910000000000
DOCNOW_SUPPORT_EMAIL=dev@example.com
DOCNOW_GSTIN=local-gstin
