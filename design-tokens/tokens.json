{
  "$comment": "Single source for the DocNow 'calm clinical' design system (web + app). Edit here, then run: node design-tokens/build.mjs",
  "color": {
    "primary": "#4b2192",
    "primary-hover": "#3d1a7a",
    "primary-soft": "#f4f0fa",
    "on-primary": "#ffffff",
    "ink": "#1f1a2b",
    "ink-muted": "#57526a",
    "ink-subtle": "#6f6a80",
    "surface": "#ffffff",
    "surface-subtle": "#f8f7fa",
    "surface-muted": "#f1eff5",
    "border": "#e6e3ec",
    "border-strong": "#8f8a9e",
    "success": "#15803d",
    "success-soft": "#ecfdf3",
    "success-ink": "#166534",
    "warning": "#b45309",
    "warning-soft": "#fffbeb",
    "warning-ink": "#92400e",
    "danger": "#c0263f",
    "danger-soft": "#fff1f2",
    "danger-ink": "#9f1239",
    "info": "#1d4ed8",
    "info-soft": "#eff6ff",
    "info-ink": "#1e40af"
  },
  "legacy": {
    "$comment": "Old names still used across the code; they point at the new colours until screens move over.",
    "background": "surface",
    "foreground": "ink",
    "primary-foreground": "on-primary",
    "muted": "surface-muted",
    "muted-foreground": "ink-muted",
    "accent": "surface-muted",
    "accent-foreground": "primary",
    "destructive": "danger",
    "destructive-foreground": "on-primary",
    "success-foreground": "on-primary",
    "warning-foreground": "on-primary",
    "input": "surface-muted",
    "ring": "primary"
  },
  "font": {
    "size": {
      "caption": [12, 16],
      "small": [14, 20],
      "body": [16, 24],
      "body-lg": [18, 28],
      "title-sm": [20, 28],
      "title": [24, 32],
      "title-lg": [30, 36],
      "display": [36, 44]
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },
  "radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12, "2xl": 16 },
  "shadow": {
    "raised": { "css": "0 4px 16px rgba(31, 26, 43, 0.08)", "native": { "color": "#1f1a2b", "opacity": 0.08, "radius": 16, "offsetY": 4, "elevation": 4 } }
  }
}
